# Database — Neon (https://neon.tech), free tier, standard Postgres
# or the local docker-compose Postgres service (see docker-compose.yml)
DATABASE_URL=postgresql://fitcv:fitcv@localhost:5432/fitcv

# Auth
JWT_ACCESS_SECRET=<generate a long random string>

# Google Sign-In — OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend
GOOGLE_CLIENT_ID=
# Redirect sign-in (GET /api/v1/auth/google/start). Add GOOGLE_CALLBACK_URL to the
# OAuth client's "Authorized redirect URIs".
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback
# Where the browser lands after redirect sign-in, and the base of links in
# confirmation emails (the frontend's origin)
FRONTEND_URL=http://localhost:3002

# Confirmation emails — Resend (https://resend.com/api-keys). EMAIL_FROM must use
# a domain verified at https://resend.com/domains. If either is empty outside
# production, confirmation links are logged to the backend console instead.
RESEND_API_KEY=
EMAIL_FROM="GoMoxie <no-reply@yourdomain.com>"
# Optional: "resend" or "console" (log emails instead of sending). Unset picks
# resend when the two values above are set, else console outside production.
EMAIL_PROVIDER=

# Browser push notifications (optional). Generate a key pair with
#   npx web-push generate-vapid-keys
# Push stays off (in-app notifications still work) until all three are set.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@yourdomain.com

# First admin account — read only by `npm run admin:create`, never by the
# server. Prefer the interactive prompt; if you set these for a one-off run,
# remove ADMIN_PASSWORD afterwards.
# ADMIN_EMAIL=you@yourdomain.com
# ADMIN_PASSWORD=

# CORS — origin(s) allowed to send credentialed requests. Comma-separate
# multiple origins (e.g. if the frontend dev server can land on more than one port).
CORS_ORIGIN=http://localhost:3002

# File uploads (local disk for now — no third-party storage needed yet)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# AI — which service writes CVs: "gemini" or "groq". Only that one's key is needed.
AI_PROVIDER=gemini
# Cap on a CV generation's reply (reasoning tokens included)
AI_MAX_OUTPUT_TOKENS=4096
# Gemini — key from https://aistudio.google.com/apikey (enable billing for production)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# none | low | medium | high — "thinking" before answering, billed as output tokens
GEMINI_REASONING_EFFORT=low
# Mistral — key from https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-medium-latest
# Groq — key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# App
PORT=8000
NODE_ENV=development

# Chapa — local-market (Ethiopia) alternative to Polar for GoMoxie Pro.
# Chapa has no recurring billing, so each payment buys a fixed 1-month
# period (see payment.service.ts's grantChapaProPeriod) rather than an
# ongoing subscription.
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_BASE_URL=https://api.chapa.global
CHAPA_API_VERSION=v1
# Where Chapa redirects the customer after checkout.
CHAPA_RETURN_URL=http://localhost:3002/payment/chapa/return
# Used to verify POST /api/v1/payments/webhook/chapa signatures.
CHAPA_WEBHOOK_SECRET=
# Price of one 1-month GoMoxie Pro period via Chapa.
CV_PAYMENT_PRICE=80
CV_PAYMENT_CURRENCY=ETB

# Polar — GoMoxie Pro (multiple tiers) checkout + webhook sync
# Organization access token (Settings > Developers) — sandbox: https://sandbox.polar.sh
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
# Used to verify POST /api/v1/webhooks/polar signatures (Standard Webhooks).
# Get this from your Polar org's webhook endpoint settings.
POLAR_WEBHOOK_SECRET=
# Recurring Pro tiers — each is its own Polar product id. Leave empty until
# created; checkout for a plan with no id configured fails with a clear
# PLAN_NOT_CONFIGURED error instead of at server startup.
POLAR_PRODUCT_WEEKLY_ID=
POLAR_PRODUCT_MONTHLY_ID=
POLAR_PRODUCT_QUARTERLY_ID=
# One-time pay-per-use credits (not subscriptions) — one extra Create or
# Tailor generation per purchase. Same empty-until-configured behavior.
POLAR_PRODUCT_NEWCV_ID=
POLAR_PRODUCT_TAILORING_ID=
# Where Polar redirects the customer after checkout — should point at the
# frontend's Polar return page.
POLAR_CHECKOUT_RETURN_URL=http://localhost:3002/payment/polar/return

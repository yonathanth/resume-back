{{!--
  "Banner" — uppercase name and title, one line of contacts over a rule, and
  light gray band headings. Entries override the shared markup: jobs read
  "Role | Company" with the dates (and place, beneath) in a mid-page column;
  degrees put the institution on the title line and the degree beneath it.
--}}
{{#*inline "cv-entries"}}
  <div class="entries">
    {{#each entries}}
      <div class="entry">
        <div class="entry-head">
          <div class="e-title">
            {{#if url}}<a href="{{href url}}">{{title}}</a>{{else}}{{title}}{{/if}}{{#if subtitle}}{{#unless (eq ../key "education")}}<span class="e-sep"> | </span><span class="e-org">{{subtitle}}</span>{{/unless}}{{/if}}
          </div>
          {{#if date}}<div class="e-date">{{date}}{{#unless (eq ../key "education")}}{{#if location}}<span class="e-loc">{{location}}</span>{{/if}}{{/unless}}</div>{{else}}{{#unless (eq ../key "education")}}{{#if location}}<div class="e-date"><span class="e-loc">{{location}}</span></div>{{/if}}{{/unless}}{{/if}}
        </div>
        {{#if (eq ../key "education")}}
          {{#if subtitle}}<div class="e-line">{{subtitle}}{{#if location}}<span class="e-place">, {{location}}</span>{{/if}}</div>{{else if location}}<div class="e-line e-place">{{location}}</div>{{/if}}
        {{/if}}
        {{#if meta}}<div class="e-meta">{{meta}}</div>{{/if}}
        {{#if description}}<p class="e-desc">{{description}}</p>{{/if}}
        {{> cv-bullets}}
      </div>
    {{/each}}
  </div>
{{/inline}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{#if personal.full_name}}{{personal.full_name}} – {{/if}}CV</title>
  <style>{{{styles}}}</style>
</head>
<body class="{{mode}}">
  <main class="page">
    <header class="cv-header">
      <h1>{{personal.full_name}}</h1>
      {{#if personal.title}}<p class="headline">{{personal.title}}</p>{{/if}}
      {{#if contacts.length}}
        <ul class="contacts">
          {{#each contacts}}
            <li class="contact c-{{kind}}">{{#if href}}<a href="{{href}}">{{text}}</a>{{else}}{{text}}{{/if}}</li>
          {{/each}}
        </ul>
      {{/if}}
    </header>
    {{#each sections}}{{> section}}{{/each}}
  </main>
</body>
</html>

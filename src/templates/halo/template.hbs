{{!-- "Halo" — after ReCeiVe: a header band with a round photo and headline, a grey sidebar, orange highlights. --}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{#if personal.full_name}}{{personal.full_name}} – {{/if}}CV</title>
  <style>{{{styles}}}</style>
</head>
<body class="{{mode}}">
  <main class="page">
    <header class="cv-header">
      {{#if photo}}<img class="photo" src="{{photo}}" alt="" />{{/if}}
      <div class="identity">
        <h1><span class="first">{{firstNames personal.full_name}}</span> <span class="last">{{lastName personal.full_name}}</span></h1>
        {{#if personal.title}}<p class="headline">{{personal.title}}</p>{{/if}}
        {{> cv-contacts}}
      </div>
    </header>
    <div class="columns">
      <aside class="side">{{#each sidebarSections}}{{> section}}{{/each}}</aside>
      <div class="main">{{#each mainSections}}{{> section}}{{/each}}</div>
    </div>
  </main>
</body>
</html>

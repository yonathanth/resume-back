{{!--
  "Linen" — a spaced serif name and small-caps title, contacts in a beige
  bar, and ruled uppercase headings over justified text. Entries override the
  shared markup so jobs lead with the company (bold) and then the position
  (italic), dates on the right; other sections lead with their title.
--}}
{{#*inline "cv-entries"}}
  <div class="entries">
    {{#each entries}}
      <div class="entry">
        <div class="entry-head">
          {{#if (eq ../key "experience")}}
            <div class="e-title">{{#if subtitle}}{{subtitle}}{{else}}{{title}}{{/if}}</div>
            {{#if date}}<div class="e-date">{{date}}</div>{{/if}}
            {{#if subtitle}}<div class="e-sub">{{title}}</div>{{/if}}
          {{else}}
            <div class="e-title">{{#if url}}<a href="{{href url}}">{{title}}</a>{{else}}{{title}}{{/if}}</div>
            {{#if date}}<div class="e-date">{{date}}</div>{{/if}}
            {{#if subtitle}}<div class="e-sub">{{subtitle}}</div>{{/if}}
          {{/if}}
          {{#if location}}<div class="e-loc">{{location}}</div>{{/if}}
          {{#if meta}}<div class="e-meta">{{meta}}</div>{{/if}}
        </div>
        {{#if description}}<p class="e-desc">{{description}}</p>{{/if}}
        {{> cv-bullets}}
      </div>
    {{/each}}
  </div>
{{/inline}}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{#if personal.full_name}}{{personal.full_name}} – {{/if}}Resume</title>
  <style>{{{styles}}}</style>
</head>
<body class="{{mode}}">
  <main class="page">
    <header class="cv-header">
      <h1>{{personal.full_name}}</h1>
      {{#if personal.title}}<p class="headline">{{personal.title}}</p>{{/if}}
      {{#if contacts.length}}
        <ul class="contacts">
          {{#each contacts}}
            <li class="contact c-{{kind}}">{{#if href}}<a href="{{href}}">{{text}}</a>{{else}}{{text}}{{/if}}</li>
          {{/each}}
        </ul>
      {{/if}}
    </header>
    {{#each sections}}{{> section}}{{/each}}
  </main>
</body>
</html>

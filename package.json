{
  "name": "fitcv-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"require('fs').cpSync('src/templates','dist/templates',{recursive:true})\"",
    "start": "node dist/server.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "admin:create:prod": "node dist/scripts/create-admin.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@napi-rs/canvas": "^1.0.11",
    "@polar-sh/sdk": "^1.0.0-alpha.22",
    "@prisma/client": "^6.19.3",
    "@xmldom/xmldom": "^0.9.12",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.0",
    "fastify-raw-body": "^6.0.1",
    "google-auth-library": "^11.0.2",
    "handlebars": "^4.7.9",
